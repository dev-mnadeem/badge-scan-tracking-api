# ---------------------------------------------------------------------------
# Copy to .env. Every variable below has a default except where noted.
# With SCAN_PROVIDER=fake the app runs with no credentials at all.
# ---------------------------------------------------------------------------

PORT=3000
LOG_LEVEL=info                      # fatal | error | warn | info | debug | trace

# --- Where scans come from --------------------------------------------------
# http = the live EventsCloud API (needs API_TOKEN)
# fake = replay fixtures/sample-scans.json, offline, no credentials
SCAN_PROVIDER=fake

API_URL=https://portal.eventscloud.com/api/scan
# API_TOKEN=your_token_here         # REQUIRED when SCAN_PROVIDER=http
API_TIMEOUT_MS=30000
SCAN_PAGE_SIZE=1000                 # rows the upstream API returns per request
SCAN_FIXTURE_PATH=./fixtures/sample-scans.json

# --- Polling ----------------------------------------------------------------
POLL_INTERVAL_CRON=*/5 * * * *
POLL_ON_STARTUP=true                # run one cycle immediately instead of waiting
# Cursor used the first time the checkpoint table is empty.
EVENT_START_DATE=2026-02-04T00:00:00.000Z

RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000            # ceiling on a single backoff wait

# --- Storage ----------------------------------------------------------------
DB_PATH=./fankave.db

# --- WebSocket --------------------------------------------------------------
WS_HEARTBEAT_MS=30000               # ping interval; silent clients are dropped
WS_MAX_BUFFERED_BYTES=1048576       # a client buffering past this is terminated
WS_LEADERBOARD_LIMIT=100            # players carried in a snapshot or update

# --- Event briefing (GET /insights/summary) ---------------------------------
# local     = deterministic, computed from the database, no API key
# anthropic = Claude writes the prose from the same numbers (needs a key)
INSIGHTS_PROVIDER=local
# ANTHROPIC_API_KEY=sk-ant-...      # REQUIRED when INSIGHTS_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5

# --- Debugging --------------------------------------------------------------
# API_DEBUG_ERRORS=true             # expose error messages and stacks in responses
